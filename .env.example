# Copy this file to .env and adjust as needed.
# Default setup requires zero API keys (uses local Ollama).

# --- Redpanda ---
REDPANDA_BROKERS=redpanda:9092
TOPIC_FILTERED=wiki.edits.filtered
TOPIC_ENRICHED=wiki.edits.enriched
TOPIC_REVIEW=wiki.edits.review
CONSUMER_GROUP_ID=reasoning-service

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wiki_edits
POSTGRES_USER=wiki
POSTGRES_PASSWORD=wiki
DATABASE_URL=postgresql://wiki:wiki@postgres:5432/wiki_edits

# --- Wikipedia API ---
WIKI_USER_AGENT=fde-takehome-bot/0.1 (contact: lmjampana1997@gmail.com)

# --- LLM provider ---
# One of: ollama | anthropic | openai
LLM_PROVIDER=ollama

# Ollama (default, local, no key needed)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# Optional hosted override: Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional hosted override: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Serve layer ---
SERVE_PORT=8080
